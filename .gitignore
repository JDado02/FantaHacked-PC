# --- roba che si rigenera, e che quindi non va nel repository ---------------

# I due database. Il primo si scarica, il secondo e' l'asta di chi sta
# giocando: nessuno dei due appartiene al codice.
database/dati.db
motore/asta.db
motore/fanta.db
motore/fanta.db.prima-della-divisione
*.db.precedente
*.db.parziale

# L'asta usa e getta che prove e script si creano per non toccare quella vera.
motore/servizio_*.db

# Le copie usa e getta che le simulazioni creano per non pestarsi i piedi:
# una per asta e per processo, cancellate a fine giro.
simulazioni/cento_*.db
simulazioni/cento_*.db-journal
simulazioni/*_[0-9]*_[0-9]*.db
pubblicazione/

# Le cartelle di lavoro di PyInstaller: si rifanno con un comando.
build/lavoro/
build/dist/

# Il file unico resta fuori: comodo da tenere qui e su una chiavetta, ma non
# e' quello che si mette online. Un eseguibile "onefile" si scompatta da solo
# in una cartella temporanea a ogni avvio, che e' la descrizione di un
# dropper, e Windows Defender su questo ha tirato fuori
# `Trojan:Win32/Wacatac.B!ml`. Ricompilare lo fa sparire finche' quel file non
# viene giudicato di nuovo: e' un rinvio, non una soluzione.
FantaHacked.exe

# Quello che si scarica e' la versione a cartella, impacchettata. Non si
# scompatta niente, parte piu' in fretta, e sullo stesso computer con le
# stesse definizioni passa pulita.
!/FantaHacked-Windows.zip

# Il pacchetto pronto da pubblicare: sta nel repository dei dati, non qui.
pubblicazione/

# Segnaposto che il programma scrive mentre gira.
motore/fanta.lock
motore/fanta.porta
motore/preferenze.json

# Python
__pycache__/
*.pyc
*.pyo

# Registri
*.log
