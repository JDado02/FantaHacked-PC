# --- roba che si rigenera, e che quindi non va nel repository ---------------

# I due database. Il primo si scarica, il secondo e' l'asta di chi sta
# giocando: nessuno dei due appartiene al codice.
database/dati.db
motore/asta.db
motore/fanta.db
motore/fanta.db.prima-della-divisione
*.db.precedente
*.db.parziale

# L'asta usa e getta che prove e script si creano per non toccare quella vera.
motore/servizio_*.db

# Le copie usa e getta che le simulazioni creano per non pestarsi i piedi:
# una per asta e per processo, cancellate a fine giro.
simulazioni/cento_*.db
simulazioni/cento_*.db-journal
simulazioni/*_[0-9]*_[0-9]*.db
pubblicazione/

# La cartella di lavoro di PyInstaller: si rifa' con un comando.
build/lavoro/
build/dist/

# L'eseguibile invece **sta** nel repository, ed e' una scelta.
# Serve un link che si apra da Windows e scarichi il programma senza dover
# clonare niente: e' lo stesso motivo per cui l'apk sta nel repository
# Android. Ventidue megabyte, uno solo, sovrascritto a ogni versione invece
# che accumulato - il posto giusto sarebbe una release di GitHub, che pero'
# vuole un token API mentre il push ha gia' le sue credenziali.
!/FantaHacked.exe

# Il pacchetto pronto da pubblicare: sta nel repository dei dati, non qui.
pubblicazione/

# Segnaposto che il programma scrive mentre gira.
motore/fanta.lock
motore/fanta.porta
motore/preferenze.json

# Python
__pycache__/
*.pyc
*.pyo

# Registri
*.log
